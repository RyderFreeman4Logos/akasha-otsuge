{"at":0,"entries":[{"active":true,"body":"The Standard (Philippines)\nThe Standard is a majority broadsheet newspaper in the Philippines. It is owned by the Romualdez family. Romualdezes also owns Journal Publications, Inc., the proprietor of the People's Journal, a tabloid newspaper.Initially established as the Manila Standard, it merged with another newspaper of record, Today,  on March 6, 2005 and became Manila Standard Today or MST and recently rebranded as The Standard.","memory":1000000,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 0","memory":1000008,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 8","memory":1000016,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 16","memory":1000024,"scope":0,"seq":0}],"next":null,"permission_revision":1,"retrieval_mode":"historical_state","validated_at_seq":1}
