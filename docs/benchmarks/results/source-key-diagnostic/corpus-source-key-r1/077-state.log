{"at":0,"entries":[{"active":true,"body":"The Standard (Philippines)\nThe Standard is a majority broadsheet newspaper in the Philippines. It is owned by the Romualdez family. Romualdezes also owns Journal Publications, Inc., the proprietor of the People's Journal, a tabloid newspaper.Initially established as the Manila Standard, it merged with another newspaper of record, Today,  on March 6, 2005 and became Manila Standard Today or MST and recently rebranded as The Standard.","memory":1000000,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 0","memory":1000008,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 1","memory":1000009,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 2","memory":1000010,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 3","memory":1000011,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 4","memory":1000012,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 5","memory":1000013,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 6","memory":1000014,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 7","memory":1000015,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 8","memory":1000016,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 9","memory":1000017,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 10","memory":1000018,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 11","memory":1000019,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 12","memory":1000020,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 13","memory":1000021,"scope":0,"seq":0},{"active":true,"body":"Synthetic backfill diagnostic only 14","memory":1000022,"scope":0,"seq":0},{"active":true,"body":"